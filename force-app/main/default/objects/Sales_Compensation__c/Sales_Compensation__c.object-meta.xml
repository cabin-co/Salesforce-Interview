<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores inbound sales compensation transactions, calculated commission values, and webhook delivery audit details.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <label>Sales Compensation</label>
    <nameField>
        <displayFormat>COMP-{000000}</displayFormat>
        <label>Compensation Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Sales Compensations</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>Transaction_Id__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Sales_Rep_External_Id__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Opportunity_External_Id__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Final_Commission_Amount__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Webhook_Status__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ReadWrite</sharingModel>
</CustomObject>
